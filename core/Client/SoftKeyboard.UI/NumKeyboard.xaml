<UserControl x:Class="SoftKeyboard.UI.NumKeyboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SoftKeyboard.UI"
             mc:Ignorable="d" 
             x:Name="Numkeyboard"
             d:DesignHeight="500" d:DesignWidth="1400">
        <StackPanel Name="row0" Orientation="Horizontal" HorizontalAlignment="Center">
            <local:ShiftViewKey NormalContent="1"/>
            <local:ShiftViewKey NormalContent="2"/>
            <local:ShiftViewKey NormalContent="3"/>
            <local:ShiftViewKey NormalContent="4"/>
            <local:ShiftViewKey NormalContent="5"/>
            <local:ShiftViewKey NormalContent="6"/>
            <local:ShiftViewKey NormalContent="7"/>
            <local:ShiftViewKey NormalContent="8"/>
            <local:ShiftViewKey NormalContent="9"/>
            <local:ShiftViewKey NormalContent="0"/>
            <local:ShiftViewKey NormalContent="-"/>
    </StackPanel>
</UserControl>
